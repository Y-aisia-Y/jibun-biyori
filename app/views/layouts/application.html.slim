doctype html
html
  head
    - meta_tags = { site: 'じぶん日和', title: 'My Daily Pace', description: '体調・活動・気分を記録して、自分のリズムを取り戻すWebアプリです。休職中の方や復職を目指す方の生活記録をサポートします。', og: { title: :title, description: :description, type: 'website', url: request.url, image: asset_url('ogp.png'), site_name: 'じぶん日和' }, twitter: { card: 'summary_large_image', image: asset_url('ogp.png') } }
    = display_meta_tags(meta_tags)
    meta name="viewport" content="width=device-width,initial-scale=1"
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "tailwind", "application", "data-turbo-track": "reload", preload: false
    = javascript_importmap_tags
    = javascript_include_tag "https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"
    = javascript_include_tag "https://cdn.jsdelivr.net/npm/chartkick@5.0.1/dist/chartkick.min.js"
    = javascript_include_tag "https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"
    
    - if Rails.env.production?
      script async=true src="https://www.googletagmanager.com/gtag/js?id=G-5MX5K1GFS0"
      javascript:
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        document.addEventListener('turbo:load', function(event) {
          gtag('config', 'G-5MX5K1GFS0', {
            'page_location': event.detail.url
          });
        });
  body
    = render "shared/header"
    = render "shared/flash"

    / ゲストログイン
    - if user_signed_in? && current_user.guest?
      div class="bg-amber-50 border-b border-amber-200 text-amber-800 text-sm text-center py-2 px-4"
        | ゲストアカウントでログイン中です。ログアウトすると同じアカウントには戻れません。データは定期的に削除されます。
        = button_to "ログアウトして登録する", guest_sign_out_path, method: :delete, class: "underline font-medium ml-2 bg-transparent border-none cursor-pointer text-amber-800 transition duration-200 transform hover:scale-105 active:scale-95"

    main.min-h-screen
      .flex-grow
        = yield

      footer.text-center.py-4.text-xs.text-gray-400
        .flex.items-center.justify-center.gap-4.mb-2
          = link_to "https://github.com/Y-aisia-Y", target: "_blank", rel: "noopener", class: "hover:text-gray-600 transition text-xl" do
            i.fa-brands.fa-github
          = link_to "https://x.com/Y_aisia_Y", target: "_blank", rel: "noopener", class: "hover:text-sky-500 transition text-xl" do
            i.fa-brands.fa-x-twitter

        p v1.1.1 / © 2026 jibun-biyori