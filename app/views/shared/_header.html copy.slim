/ 日付ロジック
- if user_signed_in?
  - @display_date ||= Date.current
  - display_record = current_user.records.find_by(recorded_date: @display_date)
  - diary_path = display_record&.diary_memo.to_s.strip.present? ? edit_diary_record_path(display_record) : new_diary_records_path(date: @display_date)
  - health_path = display_record ? edit_record_path(display_record, from: 'dashboard') : new_health_records_path(date: @display_date)
  - health_label = display_record ? "体調を編集" : "体調記入"

/ ヘッダー本体
.header.custom-header.px-4.py-3.flex.items-center.justify-between.relative[data-controller="menu"]
  = link_to (user_signed_in? ? authenticated_root_path : unauthenticated_root_path),
    class: "header-title flex items-center gap-2 font-bold text-lg transition" do
    span.text-2xl 🌿
    span じぶん日和

  .flex.items-center.gap-2
    - if user_signed_in?
      = link_to mypage_root_path do
        - if current_user.avatar.present?
          = image_tag current_user.avatar.url, class: "w-5 h-5 rounded-full object-cover border"
        - else
          = image_tag "default_avatar.png", class: "w-5 h-5 rounded-full object-cover border"

    / ハンバーガー
    button.text-2xl.p-2.hover:bg-gray-100.rounded.transition[data-action="click->menu#toggle"] ☰

    / ドロップダウンパネル
    #menu-panel.hidden.bg-white.border.border-gray-200.shadow-lg.rounded-md.absolute.right-3.top-full.mt-2.w-48.z-50[
      data-menu-target="panel"
    ]
      ul.py-1
        - if user_signed_in?
          li
            = link_to "ダッシュボード", authenticated_root_path,
              class: "block px-4 py-2 text-gray-700 hover:bg-gray-100 transition"

          li 
            = link_to "月間カレンダー", calendar_path,
              class: "block px-4 py-2 text-gray-700 hover:bg-gray-100 transition"

          / 体調・分析グループ
          li
            details.group
              summary.flex.items-center.justify-between.px-4.py-3.cursor-pointer.hover:bg-opacity-50.list-none
                span 体調・分析
                span.menu-arrow.text-xs.transition-transform.group-open:rotate-180 ▼
              ul.bg-gray-50.py-1
                li
                  = link_to health_label, health_path,
                    class: "block pl-8 pr-4 py-2 text-sm text-gray-600 hover:bg-gray-200"
                li
                  = link_to "分析グラフ", charts_path,
                    class: "block pl-8 pr-4 py-2 text-sm text-gray-600 hover:bg-gray-200"

          / 日記グループ
          li
            details.group
              summary.flex.items-center.justify-between.px-4.py-3.cursor-pointer.hover:bg-opacity-50.list-none
                span 日記
                span.menu-arrow.text-xs.transition-transform.group-open:rotate-180 ▼
              ul.bg-gray-50.py-1
                li
                  = link_to (display_record&.diary_memo.to_s.strip.present? ? "日記を編集" : "日記を書く"), diary_path,
                    class: "block pl-8 pr-4 py-2 text-sm text-gray-600 hover:bg-gray-200"
                li
                  = link_to "日記一覧", records_path,
                    class: "block pl-8 pr-4 py-2 text-sm text-gray-600 hover:bg-gray-200"
          li
            = link_to "マイページ", mypage_root_path,
              class: "block px-4 py-2 text-gray-700 hover:bg-gray-100 transition"
        / 未ログイン画面
        - else
          li
            = link_to "利用規約", terms_path,
              class: "block px-4 py-2 text-gray-700 hover:bg-gray-100 transition"
          li
            = link_to "プライバシーポリシー", privacy_path,
              class: "block px-4 py-2 text-gray-700 hover:bg-gray-100 transition"